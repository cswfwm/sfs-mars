{
  "spec": "sfsai/1",
  "meta": {
    "name": "Ares-III 地球逃逸（转移注入）",
    "author": "AI",
    "description": "自 80 km 地球圆轨道顺速度点火，把轨道抬成双曲（ecc>=1），即地火转移注入。单天体仿真下验证燃烧量；真正的跨天体会合由 SFS 地图的转移窗口决定，本引擎不建模。",
    "tags": ["escape", "transfer"]
  },
  "craft": { "name": "Ares-III 地火运载器", "stages": 3, "twr": 1.51 },
  "defaults": {
    "tickMs": 50,
    "startOn": "manual",
    "limits": { "maxPitchRate": 8, "maxQ": 35000, "maxThrottleRate": 2.0, "minFuelAbort": 0.01 }
  },
  "vars": { "escapeEcc": 1.0 },
  "program": [
    {
      "id": "sev_burn",
      "do": [
        { "pitch": { "mode": "prograde" } },
        { "engine": "on" },
        { "throttle": 1.0 },
        { "log": "转移注入点火" }
      ],
      "until": { "field": "ecc", "op": ">=", "value": 1.0 },
      "timeout": 300,
      "next": "cutoff"
    },
    {
      "id": "cutoff",
      "do": [
        { "throttle": 0 },
        { "engine": "off" },
        { "log": "转移注入完成，进入日心转移轨道" }
      ]
    }
  ],
  "onAbort": [
    { "id": "abort_cut", "do": [{ "engine": "off" }, { "log": "中止：关机" }] }
  ],
  "onEnd": [{ "id": "end_cut", "do": [{ "engine": "off" }] }]
}
